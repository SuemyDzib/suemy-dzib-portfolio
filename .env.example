# Copia este archivo como .env.local y llena los valores que necesites.
# Todas las variables son opcionales. Nunca subas .env.local a GitHub.

# ID de medición de Google Analytics 4, por ejemplo G-ABC123XYZ
NEXT_PUBLIC_GA_ID=

# Código de verificación de Google Search Console (solo el valor de content="...")
GOOGLE_SITE_VERIFICATION=

# Dirección pública del sitio, ejemplo https://example.vercel.app
NEXT_PUBLIC_SITE_URL=
